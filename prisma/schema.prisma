// Database schema: word lists -> words -> phoneme units, plus saved
// activity configs. SQLite for a zero-setup, single-file database.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  // linux-musl-openssl-3.0.x: needed for the Alpine-based Docker image.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// A named, reusable collection of words.
model WordList {
  id          String           @id @default(cuid())
  name        String
  description String?
  words       Word[]
  activities  ActivityConfig[]
  events      GenerationEvent[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

// One phoneme-based word, belonging to a WordList.
model Word {
  id          String         @id @default(cuid())
  englishWord String
  wordListId  String
  wordList    WordList       @relation(fields: [wordListId], references: [id], onDelete: Cascade)
  phonemes    PhonemeUnit[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([wordListId])
}

// One phoneme symbol + position per row, so multi-character symbols
// (e.g. "tʃ", "eː") are never split incorrectly.
model PhonemeUnit {
  id       String @id @default(cuid())
  symbol   String
  position Int
  wordId   String
  word     Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId])
  @@unique([wordId, position])
}

// A saved Wordle or Word Search configuration pointing at a WordList.
model ActivityConfig {
  id          String   @id @default(cuid())
  type        String   // "WORDLE" | "WORD_SEARCH"
  title       String
  difficulty  String   @default("MEDIUM") // "EASY" | "MEDIUM" | "HARD"
  showHints   Boolean  @default(true)
  maxGuesses  Int?     // Wordle only
  gridRows    Int?     // Word Search only
  gridCols    Int?     // Word Search only
  wordListId  String
  wordList    WordList @relation(fields: [wordListId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([wordListId])
}

// One record per Generate-button click, success or failure. Powers the
// dashboard's generation counts and recent-failures alert list.
model GenerationEvent {
  id          String    @id @default(cuid())
  type        String    // "WORDLE" | "WORD_SEARCH"
  outcome     String    // "SUCCESS" | "FAILURE"
  errorReason String?   // set when outcome is FAILURE
  wordListId  String?
  wordList    WordList? @relation(fields: [wordListId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([createdAt])
  @@index([type])
}

// One record per page visit duration. Powers the dashboard's average
// time-on-page metric.
model PageViewEvent {
  id         String   @id @default(cuid())
  page       String
  durationMs Int
  createdAt  DateTime @default(now())

  @@index([page])
}
